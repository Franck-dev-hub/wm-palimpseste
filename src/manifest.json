{
  "manifest_version": 3,
  "name": "Palimpseste pour WikiMasters",
  "version": "0.1.0",
  "description": "Extension non officielle qui enrichit l'affichage de WikiMasters.",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": ["https://*.wiki-masters.com/*"],
      "js": ["content.js"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "palimpseste@exemple.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
